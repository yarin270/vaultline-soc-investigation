index="vaultline" sourcetype="cloudaudit" actor="r.zohar" | eval hour=strftime(_time,"%H"), target_class=case(match(target_object,"^/internal/config/pipeline-[^/]+\.yaml$"),"pipeline_config",match(target_object,"^/cust-[0-9]{3}/record-[0-9]{4}\.dat$"),"customer_record",true(),"other") | stats count min(_time) as first_seen max(_time) as last_seen min(bytes) as min_bytes max(bytes) as max_bytes values(hour) as hours values(target_object) as targets by src_ip target_class | sort 0 first_seen
