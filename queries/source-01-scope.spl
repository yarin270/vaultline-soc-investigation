index="vaultline" sourcetype="cloudaudit" src_ip="31.154.88.203" operation="get_object" | rex field=target_object "^/(?<namespace>[^/]+)/" | stats count as total_events dc(namespace) as total_namespaces dc(eval(if(match(namespace,"^cust-[0-9]{3}$"),namespace,null()))) as customer_namespaces count(eval(if(namespace="internal",1,null()))) as internal_events sum(bytes_out) as total_bytes | eval total_GiB=round(total_bytes/1024/1024/1024,2), total_GB=round(total_bytes/1000/1000/1000,2)
